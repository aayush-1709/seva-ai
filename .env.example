# =============================================================================
# SevaAI — environment template
# Copy to `.env` in this folder (`seva-ai/.env`):
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows CMD)
# Then fill in secrets. Never commit `.env`.
#
# • Python (FastAPI / uvicorn) reads these via python-dotenv.
# • Vite exposes ONLY variables prefixed with VITE_ to the browser.
# • Keep Gemini and service-account paths server-side only (no VITE_GEMINI_*).
# =============================================================================

# --- Backend: Google Gemini (report refinement, AI features) ---
GEMINI_API_KEY=
# If true, backend fails hard when Gemini is unavailable instead of using fallbacks.
GEMINI_STRICT_MODE=false

# --- Backend: Google Maps (optional; haversine math does not call Maps APIs today;
#     health endpoint reports whether a key is configured.) ---
GOOGLE_MAPS_API_KEY=

# --- Backend: Firestore ---
# Absolute or project-relative path to the Firebase **service account** JSON.
# Example (Windows):  FIREBASE_CREDENTIALS_PATH=C:\secrets\seva-firebase.json
# Example (Unix):    FIREBASE_CREDENTIALS_PATH=/home/you/secrets/seva-firebase.json
FIREBASE_CREDENTIALS_PATH=

# --- Backend: CORS ---
# Comma-separated list of allowed frontend origins.
# Set to "*" to allow ALL origins (easiest for demos / hackathons).
# Example: https://sevaai.vercel.app,https://my-other-frontend.com
ALLOWED_ORIGINS=*

# --- Frontend: Vite (browser-safe) ---
# Python API base URL (no trailing slash).
# Local dev:   http://127.0.0.1:8000
# Production:  https://your-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Maps **JavaScript** API key (Impact Map, heatmaps). Restrict by HTTP referrer in GCP.
VITE_GOOGLE_MAPS_API_KEY=

# --- Dev tooling (optional) ---
# Set to true in AI Studio or constrained environments to reduce HMR flicker.
DISABLE_HMR=false
